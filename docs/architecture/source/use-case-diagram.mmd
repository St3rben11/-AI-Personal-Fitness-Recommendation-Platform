        uc9(["UC-09 View dashboard"])
        uc11(["UC-11 Maintain exercise library & rules"])
        uc10(["UC-10 Validate input data"])
        uc4(["UC-04 Select fitness goal"])
        uc5(["UC-05 Select activity level"])
    end

    guest --- uc1
    guest --- uc3
    guest --- uc6
    guest --- uc7
    user --- uc2
    user --- uc8
    user --- uc9
    admin --- uc11

    uc3 -. "«include»" .-> uc10
    uc3 -. "«include»" .-> uc4
    uc3 -. "«include»" .-> uc5
    uc6 -. "«include»" .-> uc10
    uc9 -. "«include»" .-> uc8

    classDef uc fill:#eff6ff,stroke:#1d4ed8,color:#0f172a
    classDef inc fill:#f8fafc,stroke:#64748b,color:#0f172a
